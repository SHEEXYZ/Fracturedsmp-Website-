<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FractureddSMP Official Website</title>
  <meta name="description" content="Official website of FractureddSMP - A Minecraft SMP server." />

  <style>
    :root {
      --bg: #0b0f14;
      --bg-2: #111821;
      --card: #151f2b;
      --card-2: #1b2838;
      --text: #f4f7fb;
      --muted: #9fb0c3;
      --green: #54d66a;
      --green-dark: #2f9e44;
      --border: rgba(255, 255, 255, 0.1);
      --shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(84, 214, 106, 0.12), transparent 35%),
        radial-gradient(circle at bottom right, rgba(58, 120, 255, 0.10), transparent 35%),
        var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: 0 auto;
    }

    /* NAVBAR */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(11, 15, 20, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }

    .brand-badge {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--green), var(--green-dark));
      color: #071009;
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(84, 214, 106, 0.25);
      font-size: 18px;
    }

    .brand span {
      font-size: 1.05rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 22px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1px solid transparent;
      font-weight: 800;
      cursor: pointer;
      transition: 0.2s ease;
      font-size: 0.95rem;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--green), var(--green-dark));
      color: #071009;
      box-shadow: 0 10px 25px rgba(84, 214, 106, 0.18);
    }

    .btn-outline {
      background: transparent;
      border-color: var(--border);
      color: var(--text);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    /* HERO */
    .hero {
      padding: 90px 0 70px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 36px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border: 1px solid rgba(84, 214, 106, 0.3);
      background: rgba(84, 214, 106, 0.08);
      color: #b8f5c2;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(2.3rem, 6vw, 4.8rem);
      line-height: 1.05;
      letter-spacing: -1.5px;
      margin-bottom: 18px;
    }

    .hero h1 span {
      color: var(--green);
    }

    .hero p {
      color: var(--muted);
      max-width: 620px;
      font-size: 1.05rem;
      margin-bottom: 26px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 28px;
    }

    .ip-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      max-width: 430px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 14px;
      box-shadow: var(--shadow);
    }

    .ip-label {
      display: block;
      color: var(--muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 2px;
    }

    .ip-value {
      font-weight: 900;
      font-family: Consolas, Monaco, monospace;
      color: #d8ffe0;
      word-break: break-all;
    }

    .copy-btn {
      border: 0;
      background: rgba(84, 214, 106, 0.14);
      color: #b8f5c2;
      border-radius: 10px;
      padding: 10px 12px;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
    }

    .copy-btn:hover {
      background: rgba(84, 214, 106, 0.24);
    }

    /* HERO CARD */
    .hero-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      background:
        linear-gradient(160deg, rgba(84, 214, 106, 0.08), transparent 40%),
        var(--card);
      border-radius: 26px;
      padding: 24px;
      box-shadow: var(--shadow);
    }

    .hero-card::before {
      content: "";
      position: absolute;
      inset: -60px -60px auto auto;
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(84, 214, 106, 0.22), transparent 65%);
      pointer-events: none;
    }

    .server-preview {
      aspect-ratio: 4 / 3;
      border-radius: 18px;
      background:
        linear-gradient(135deg, rgba(84, 214, 106, 0.18), transparent),
        repeating-linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.04) 0 2px,
          transparent 2px 18px
        ),
        #0e151d;
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
      text-align: center;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    .server-preview h3 {
      font-size: 1.6rem;
      margin-bottom: 6px;
    }

    .server-preview p {
      color: var(--muted);
      font-size: 0.9rem;
      margin: 0;
    }

    .pixel-block {
      width: 64px;
      height: 64px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--green), var(--green-dark));
      box-shadow:
        0 0 0 6px rgba(84, 214, 106, 0.12),
        0 0 40px rgba(84, 214, 106, 0.18);
      margin: 0 auto 16px;
      transform: rotate(6deg);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 16px;
    }

    .stat {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
    }

    .stat strong {
      display: block;
      font-size: 1.05rem;
    }

    .stat small {
      color: var(--muted);
      font-size: 0.75rem;
    }

    /* SECTIONS */
    section {
      padding: 70px 0;
    }

    .section-head {
      max-width: 700px;
      margin-bottom: 34px;
    }

    .section-head h2 {
      font-size: clamp(1.8rem, 4vw, 2.7rem);
      letter-spacing: -0.8px;
      margin-bottom: 10px;
    }

    .section-head p {
      color: var(--muted);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .card {
      background: linear-gradient(180deg, var(--card-2), var(--card));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      box-shadow: var(--shadow);
    }

    .card-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: rgba(84, 214, 106, 0.12);
      color: var(--green);
      font-size: 1.25rem;
      margin-bottom: 14px;
    }

    .card h3 {
      margin-bottom: 8px;
      font-size: 1.1rem;
    }

    .card p {
      color: var(--muted);
      font-size: 0.95rem;
    }

    /* JOIN STEPS */
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      counter-reset: step;
    }

    .step {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px 20px 20px;
    }

    .step::before {
      counter-increment: step;
      content: counter(step);
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--green);
      color: #071009;
      font-weight: 900;
      margin-bottom: 14px;
    }

    .step h3 {
      margin-bottom: 6px;
    }

    .step p {
      color: var(--muted);
      font-size: 0.94rem;
    }

    /* CTA */
    .cta {
      background:
        radial-gradient(circle at top right, rgba(84, 214, 106, 0.18), transparent 40%),
        var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 34px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      box-shadow: var(--shadow);
    }

    .cta h2 {
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      margin-bottom: 6px;
    }

    .cta p {
      color: var(--muted);
    }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      padding: 28px 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-links a:hover {
      color: var(--text);
    }

    /* TOAST */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%) translateY(20px);
      background: #e8fff0;
      color: #071009;
      padding: 12px 18px;
      border-radius: 12px;
      font-weight: 800;
      box-shadow: var(--shadow);
      opacity: 0;
      pointer-events: none;
      transition: 0.25s ease;
      z-index: 999;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-card {
        max-width: 560px;
      }

      .cards,
      .steps {
        grid-template-columns: 1fr 1fr;
      }

      .nav-links {
        display: none;
      }
    }

    @media (max-width: 620px) {
      .hero {
        padding: 60px 0 40px;
      }

      .cards,
      .steps {
        grid-template-columns: 1fr;
      }

      .hero-stats {
        grid-template-columns: 1fr;
      }

      .cta {
        flex-direction: column;
        align-items: flex-start;
        padding: 24px;
      }

      .ip-box {
        flex-direction: column;
        align-items: stretch;
      }

      .copy-btn {
        width: 100%;
      }

      .brand span {
        font-size: 0.95rem;
      }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <div class="container nav">
      <a href="#" class="brand">
        <div class="brand-badge">⛏</div>
        <span>FractureddSMP</span>
      </a>

      <nav class="nav-links">
        <a href="#about">About</a>
        <a href="#features">Features</a>
        <a href="#join">How to Join</a>
        <a href="#community">Community</a>
      </nav>

      <a class="btn btn-primary" href="#join">Join Now</a>
    </div>
  </header>

  <!-- HERO -->
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">🟢 Minecraft SMP Server</div>

          <h1>Welcome to <span>FractureddSMP</span></h1>

          <p>
            A community-driven Minecraft SMP built for adventurers, builders,
            and friends. Survive, build, trade, and create your own story.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#join">How to Join</a>
            <a class="btn btn-outline" href="https://discord.gg/YOUR-INVITE" target="_blank" rel="noopener">
              Join Discord
            </a>
          </div>

          <div class="ip-box">
            <div>
              <span class="ip-label">Server IP</span>
              <div class="ip-value" id="serverIp">play.fractureddsmp.net</div>
            </div>
            <button class="copy-btn" id="copyIpBtn" type="button">Copy IP</button>
          </div>
        </div>

        <aside class="hero-card">
          <div class="server-preview">
            <div>
              <div class="pixel-block"></div>
              <h3>FractureddSMP</h3>
              <p>Survive • Build • Explore • Community</p>
            </div>
          </div>

          <div class="hero-stats">
            <div class="stat">
              <strong>24/7</strong>
              <small>Online</small>
            </div>
            <div class="stat">
              <strong>SMP</strong>
              <small>Game Mode</small>
            </div>
            <div class="stat">
              <strong>Java</strong>
              <small>Edition</small>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about">
      <div class="container">
        <div class="section-head">
          <h2>About FractureddSMP</h2>
          <p>
            FractureddSMP is a Minecraft survival multiplayer server focused on
            fun, teamwork, and long-term world building.
          </p>
        </div>

        <div class="cards">
          <article class="card">
            <div class="card-icon">🌍</div>
            <h3>Survival World</h3>
            <p>Explore a persistent world where your builds and progress matter.</p>
          </article>

          <article class="card">
            <div class="card-icon">🤝</div>
            <h3>Friendly Community</h3>
            <p>Meet players, make alliances, trade resources, and build together.</p>
          </article>

          <article class="card">
            <div class="card-icon">⚒️</div>
            <h3>Build Your Legacy</h3>
            <p>Create bases, towns, farms, and stories that become part of the server.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features">
      <div class="container">
        <div class="section-head">
          <h2>Server Features</h2>
          <p>Simple, community-focused, and made for Minecraft players.</p>
        </div>

        <div class="cards">
          <article class="card">
            <div class="card-icon">🛡️</div>
            <h3>Fair Gameplay</h3>
            <p>Rules are enforced to keep the server fun and fair for everyone.</p>
          </article>

          <article class="card">
            <div class="card-icon">💬</div>
            <h3>Active Discord</h3>
            <p>Announcements, support, events, and community chats in one place.</p>
          </article>

          <article class="card">
            <div class="card-icon">🎉</div>
            <h3>Events & Updates</h3>
            <p>Join server events, community projects, and future content updates.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- HOW TO JOIN -->
    <section id="join">
      <div class="container">
        <div class="section-head">
          <h2>How to Join</h2>
          <p>Follow these steps to play on FractureddSMP.</p>
        </div>

        <div class="steps">
          <div class="step">
            <h3>Open Minecraft</h3>
            <p>Launch Minecraft Java Edition and go to Multiplayer.</p>
          </div>

          <div class="step">
            <h3>Add Server</h3>
            <p>Click “Add Server” and paste the server IP: <strong>play.fractureddsmp.net</strong></p>
          </div>

          <div class="step">
            <h3>Join & Play</h3>
            <p>Connect to the server, read the rules, and start your adventure.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMUNITY CTA -->
    <section id="community">
      <div class="container">
        <div class="cta">
          <div>
            <h2>Ready to join the SMP?</h2>
            <p>Join our Discord for announcements, support, and community updates.</p>
          </div>

          <a class="btn btn-primary" href="https://discord.gg/YOUR-INVITE" target="_blank" rel="noopener">
            Join Discord Server
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div>© <span id="year"></span> FractureddSMP. All rights reserved.</div>

      <div class="footer-links">
        <a href="#about">About</a>
        <a href="#features">Features</a>
        <a href="#join">How to Join</a>
        <a href="https://discord.gg/YOUR-INVITE" target="_blank" rel="noopener">Discord</a>
      </div>
    </div>
  </footer>

  <!-- TOAST -->
  <div class="toast" id="toast">Server IP copied!</div>

  <script>
    // Copy server IP
    const copyBtn = document.getElementById("copyIpBtn");
    const serverIp = document.getElementById("serverIp");
    const toast = document.getElementById("toast");

    copyBtn.addEventListener("click", async () => {
      const ip = serverIp.textContent.trim();

      try {
        await navigator.clipboard.writeText(ip);
        showToast("Server IP copied!");
      } catch (error) {
        // Fallback para sa browsers na walang clipboard API
        const tempInput = document.createElement("input");
        tempInput.value = ip;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand("copy");
        document.body.removeChild(tempInput);
        showToast("Server IP copied!");
      }
    });

    let toastTimer;

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add("show");

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove("show");
      }, 1800);
    }

    // Auto year
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
